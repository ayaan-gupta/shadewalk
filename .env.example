# Copy to .env to change anything. Every value below is the default.

# Ports. 3000, 8000 and 5432 are deliberately avoided.
WEB_PORT=4107
API_PORT=8107
POSTGRES_PORT=5507

# PostGIS runs in Docker, published on 127.0.0.1 only. Local development credentials, not a secret.
POSTGRES_PASSWORD=shadewalk
POSTGIS_IMAGE=imresamu/postgis:17-3.5
# Set by scripts/dev.sh when the container is up. Leave empty to serve from the committed files.
# DATABASE_URL=postgresql://shadewalk:shadewalk@127.0.0.1:5507/shadewalk
# Set to 1 to skip the database even when Docker is available.
# SHADEWALK_NO_DB=1

# Weather: "offline" reads the committed month-by-hour climatology, "open-meteo" asks the keyless forecast API.
WEATHER_PROVIDER=offline
WEATHER_TIMEOUT_S=4

# Walking speed used for minutes, in metres per second.
WALK_SPEED_MPS=1.3

# Where the pilot dataset lives.
# SHADEWALK_DATA_DIR=data/pilot

# Browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:4107,http://127.0.0.1:4107

# Map style for MapLibre (read by Vite at build time). Any keyless style URL, or "offline" for no base map.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Leave empty to use the dev server's /api proxy.
VITE_API_BASE=

# Only for `make data`: an alternative Overpass endpoint.
# OVERPASS_URL=https://overpass-api.de/api
