{
  "name": "shadewalk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Map UI for ShadeWalk: shortest and shadiest walking routes, a shade map with a time slider and a planner view.",
  "scripts": {
    "dev": "vite --port ${WEB_PORT:-4107} --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port ${WEB_PORT:-4107} --strictPort --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
